@using Abc.Infra

<div class="d-flex align-items-center gap-2">
    @if (IsFirstPage) {
        <span>First</span>
        <span>Prev</span>
    } else {
        <a href="@FirstHref">First</a>
        <a href="@PrevHref">Prev</a>
    }

    <span>Page @PageNo / @TotalPages</span>

    @if (IsLastPage) {
        <span>Next</span>
        <span>Last</span>
    } else {
        <a href="@NextHref">Next</a>
        <a href="@LastHref">Last</a>
    }

    <span>Total: @TotalCount Rows:</span>
    @foreach (var size in Abc.Infra.Query.PageSizes) {
        if (size == PageSize) {
            <span>@size</span>
        } else {
            <a href="@SizeHref(size)">@size</a>
        }
    }
</div>

@code {
    [Parameter] public string CurrentUri { get; set; } = string.Empty;
    [Parameter] public Query Query { get; set; } = new();
    [Parameter] public int TotalCount { get; set; }

    private string BaseUri => (CurrentUri ?? string.Empty).Split('?', 2)[0];
    private int PageNo => Query?.Page ?? 1;
    private int PageSize => Query?.PageSize ?? Abc.Infra.Query.PageSizes[0];
    private string SortQuery => string.IsNullOrEmpty(Query?.SortBy)
        ? string.Empty
        : $"&SortBy={Encode(Query.SortBy)}&SortDir={Encode(Query.SortDir)}";
    private string SearchQuery => string.IsNullOrEmpty(Query?.SearchStr)
        ? string.Empty
        : $"&SearchBy={Encode(Query.SearchBy)}&SearchStr={Encode(Query.SearchStr)}";
    private int TotalPages {
        get {
            if (PageSize <= 0) return 1;
            var pages = TotalCount / PageSize;
            if (TotalCount % PageSize > 0) pages++;
            return Math.Max(1, pages);
        }
    }
    private bool IsFirstPage => PageNo <= 1;
    private bool IsLastPage => PageNo >= TotalPages;
    private string FirstHref => $"{BaseUri}?Page=1&PageSize={PageSize}{SortQuery}{SearchQuery}";
    private string PrevHref => $"{BaseUri}?Page={Math.Max(1, PageNo - 1)}&PageSize={PageSize}{SortQuery}{SearchQuery}";
    private string NextHref => $"{BaseUri}?Page={Math.Min(TotalPages, PageNo + 1)}&PageSize={PageSize}{SortQuery}{SearchQuery}";
    private string LastHref => $"{BaseUri}?Page={TotalPages}&PageSize={PageSize}{SortQuery}{SearchQuery}";
    private string SizeHref(int size) => $"{BaseUri}?Page=1&PageSize={size}{SortQuery}{SearchQuery}";
    private static string Encode(string value) => Uri.EscapeDataString(value ?? string.Empty);
}
