@using Abc.Data.Common
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Collections
@using System.Reflection

@typeparam TEntity where TEntity : BaseEntity

<QuickGrid Class="table" Items="Entities">
    @foreach (var property in typeof(TEntity).GetProperties().Where(Show)) {
        <TemplateColumn Title="@property.Name" Context="entity">
            @Value(property, entity)
        </TemplateColumn>
    }
    <TemplateColumn Context="entity">
        <a href="@($"{BasePath}/edit?id={entity.Id}")">Edit</a> |
        <a href="@($"{BasePath}/details?id={entity.Id}")">Details</a> |
        <a href="@($"{BasePath}/delete?id={entity.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    [Parameter] public IQueryable<TEntity> Entities { get; set; } = Enumerable.Empty<TEntity>().AsQueryable();
    [Parameter] public string BasePath { get; set; } = string.Empty;

    private static string Value(PropertyInfo property, TEntity entity) {
        var value = property.GetValue(entity);
        return value?.ToString() ?? string.Empty;
    }

    private static bool Show(PropertyInfo property) {
        if (property.Name == nameof(BaseEntity.Id)) return false;
        var type = property.PropertyType;
        if (type == typeof(string)) return true;
        if (typeof(IEnumerable).IsAssignableFrom(type)) return false;
        if (type.IsClass) return false;
        return true;
    }
}
