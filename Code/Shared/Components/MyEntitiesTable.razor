@using Abc.Data.Common
@using Abc.Infra
@using Abc.Shared.Code
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Collections
@using System.Reflection

@typeparam TEntity where TEntity : BaseEntity

<QuickGrid Class="table myTable" Items="Entities">
    @foreach (var property in typeof(TEntity).GetProperties().Where(Show)) {
        <TemplateColumn>
            <HeaderTemplate>
                <div class="header-stack">
                    <a href="@HeaderHref(property.Name)">@Iconed(property.Name)</a>
                    <form method="get" action="@BasePath">
                        <input type="hidden" name="@nameof(Query.Page)" value="1" />
                        <input type="hidden" name="@nameof(Query.PageSize)" value="@query.PageSize" />
                        <input type="hidden" name="@nameof(Query.SortBy)" value="@query.SortBy" />
                        <input type="hidden" name="@nameof(Query.SortDir)" value="@query.SortDir" />
                        <input type="hidden" name="@nameof(Query.SearchBy)" value="@property.Name" />
                        <input type="search"
                               class="form-control form-control-sm"
                               name="@nameof(Query.SearchStr)"
                               value="@SearchStr(property.Name)"
                               disabled="@IsDisabled(property)"
                               placeholder="Search..." />
                    </form>
                </div>
            </HeaderTemplate>
            <ChildContent Context="entity">
                @Value(property, entity)
            </ChildContent>
        </TemplateColumn>
    }
    <TemplateColumn Context="entity">
        <a href="@($"{BasePath}/edit?id={entity.Id}")">Edit</a> |
        <a href="@($"{BasePath}/details?id={entity.Id}")">Details</a> |
        <a href="@($"{BasePath}/delete?id={entity.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<MyTablePageNav Query="query" TotalCount="totalCount" CurrentUri="@navigation.Uri" />

@code {
    private IQueryable<TEntity> Entities { get; set; } = Enumerable.Empty<TEntity>().AsQueryable();
    private Query query = new();
    private int totalCount;

    [Inject] private NavigationManager navigation { get; set; } = default!;
    [Parameter] public IRepo<TEntity> Repo { get; set; } = default!;
    [Parameter] public string BasePath { get; set; } = string.Empty;

    private string SortIcon => query?.SortDir == "asc" ? " ▲" : query?.SortDir == "desc" ? " ▼" : string.Empty;
    private string Iconed(string name) => query?.SortBy == name ? name + SortIcon : name;
    private string SearchStr(string name) => query?.SearchBy == name ? query.SearchStr : string.Empty;
    private static bool IsDisabled(PropertyInfo property) => property?.PropertyType != typeof(string);

    protected override async Task OnInitializedAsync() {
        if (Repo is null) return;

        var uri = navigation.ToAbsoluteUri(navigation.Uri);
        query = new UrlParams(uri).Parse();
        totalCount = await Repo.CountAsync(query);
        Entities = (await Repo.GetAsync(query)).AsQueryable();
    }

    private static string Value(PropertyInfo property, TEntity entity) {
        var value = property.GetValue(entity);
        return value?.ToString() ?? string.Empty;
    }

    private static bool Show(PropertyInfo property) {
        if (property.Name == nameof(BaseEntity.Id)) return false;
        var type = property.PropertyType;
        if (type == typeof(string)) return true;
        if (typeof(IEnumerable).IsAssignableFrom(type)) return false;
        if (type.IsClass) return false;
        return true;
    }
    private string HeaderHref(string name) {
        var sortBy = query?.SortBy == name && query?.SortDir == "desc" ? null : name;
        var sortDir = query?.SortBy == name ? "desc" : "asc";
        var href = $"{BasePath}?Page=1&PageSize={query?.PageSize ?? Abc.Infra.Query.PageSizes[0]}";

        if (!string.IsNullOrEmpty(query?.SearchStr)) {
            href += $"&SearchBy={Encode(query.SearchBy)}&SearchStr={Encode(query.SearchStr)}";
        }

        return sortBy is null
            ? href
            : href + $"&SortBy={Encode(sortBy)}&SortDir={Encode(sortDir)}";
    }
    private static string Encode(string value) => Uri.EscapeDataString(value ?? string.Empty);
}

<style>
    .myTable {
        table-layout: fixed;
        width: 100%;
        max-width: 100%;
    }

    .myTable td {
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
</style>
