@using Abc.Data.Common
@using Abc.Infra

@typeparam TItem where TItem : BaseEntity

<PageTitle>@PageTitleText</PageTitle>

<h1>@EntityTitle</h1>

<p>
    <a href="@($"{BasePath}/create")">Create New</a>
</p>

<MyEntitiesTable TEntity="TItem" Repo="Repo" BasePath="@BasePath" />

@code {
    [Parameter] public string PageTitleText { get; set; } = "Index";
    [Parameter] public string EntityTitle { get; set; } = string.Empty;
    [Parameter] public IRepo<TItem> Repo { get; set; } = default!;
    [Parameter] public string BasePath { get; set; } = string.Empty;
}
