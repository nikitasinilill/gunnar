@page "/movies"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Infra
@using Abc.Data
@inject IMoviesRepo repo

<MyIndexPage
    TItem="Movie"
    PageTitleText="Movies Page"
    EntityTitle="Movies"
    Items="movies"
    BasePath="/movies" />

@code {
    private IQueryable<Movie> movies = Enumerable.Empty<Movie>().AsQueryable();

    protected override async Task OnInitializedAsync() {
        movies = (await repo.GetAsync()).AsQueryable();
    }
}
