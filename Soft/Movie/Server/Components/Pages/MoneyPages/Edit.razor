@page "/monies/edit"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@inject IMoniesRepo repo
@inject NavigationManager NavigationManager

<MyEditPage
    PageTitleText="Edit Money"
    EntityTitle="Money"
    Entity="money"
    BasePath="/monies"
    EntityId="@Id"
    OnValidSubmit="Update" />

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(Name = nameof(Money))] private Money money { get; set; }

    protected override async Task OnInitializedAsync() {
        money ??= await repo.GetAsync(Id);
        if (money is null) NavigationManager.NotFound();
    }

    private async Task Update() {
        await repo.UpdateAsync(money!);
        NavigationManager.NavigateTo("/monies");
    }
}
