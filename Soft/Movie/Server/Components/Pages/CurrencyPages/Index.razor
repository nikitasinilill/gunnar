@page "/currencies"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@inject ICurrenciesRepo repo

<MyIndexPage
    TItem="Currency"
    PageTitleText="Currencies Page"
    EntityTitle="Currencies"
    Items="items"
    BasePath="/currencies" />

@code {
    private IQueryable<Currency> items = Enumerable.Empty<Currency>().AsQueryable();

    protected override async Task OnInitializedAsync() {
        items = (await repo.GetAsync()).AsQueryable();
    }
}
